# 本文件由 npm run gen:env 自动生成，请勿手改
# 字段来源: backend/src/configFields.js（修改后重新生成）

# ===== 数据库配置 =====
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=haibao

# ===== 服务 =====
PORT=3001
# 生产环境必须设置；由 nginx 在反代时注入，浏览器不接触
AUTH_TOKEN=

# ===== 火山引擎 ARK =====
ARK_API_KEY=
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
# 示例: doubao-seedream-...
IMAGE_MODEL_ID=
# 示例: doubao-seedream-5-0-...
ENHANCE_MODEL_ID=

# ===== 硅基流动 =====
SILICONFLOW_API_KEY=
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1
SILICONFLOW_IMAGE_MODEL=baidu/ERNIE-Image-Turbo

# ===== DeepSeek =====
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL_ID=deepseek-v4-flash
